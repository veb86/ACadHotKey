<Project Sdk="Microsoft.NET.Sdk">
  <!-- AutoCAD 2020: SDK 23.1 / net47. AutoCAD 2021-2024: SDK 24.0 / net48.
       Build the two supported API generations separately; see experiments/package.sh. -->
  <PropertyGroup>
    <AutoCADNetVersion Condition="'$(AutoCADNetVersion)' == ''">23.1.0</AutoCADNetVersion>
    <TargetFramework Condition="$([System.String]::Copy('$(AutoCADNetVersion)').StartsWith('23.'))">net47</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ACadHotKey</AssemblyName>
    <RootNamespace>ACadHotKey.Plugin</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-time references only: AutoCAD provides these assemblies at runtime. -->
    <PackageReference Include="AutoCAD.NET" Version="$(AutoCADNetVersion)" ExcludeAssets="runtime" />
    <!-- Allows building .NET Framework projects on any OS (no Windows SDK required). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ACadHotKey.Core\ACadHotKey.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\config\ACadHotKey.config.xml" Link="ACadHotKey.config.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
